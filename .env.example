# ==============================================================================
# CODEXA APPLY V2 — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN PORTAL MASTER ACCESS KEY
# ------------------------------------------------------------------------------
# Secret master access key for unlocking https://yourdomain.com/admin
# (Never share this key publicly or in client bundles)
ADMIN_SECRET_KEY=CODEXA-ADMIN-2026
ADMIN_PASSKEY=CODEXA-ADMIN-2026

# Session cookie secret (random 32+ character string)
SESSION_SECRET=codexa_secret_session_key_2026_super_secure_hash

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Supabase PostgreSQL or MySQL)
# ------------------------------------------------------------------------------
# Option A: Supabase PostgreSQL (Recommended for production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Option B: Direct Connection String (PostgreSQL or MySQL)
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Example: mysql://root:password@localhost:3306/codexa_applications
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. EMAIL AUTOMATION (Resend — resend.com)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified Sender Email (e.g. CodeXa Agency <applications@codxa-agency.online> or onboarding@resend.dev)
EMAIL_FROM=CodeXa Agency <onboarding@resend.dev>

# Founder/Admin Notification Inbox for new application alerts
ADMIN_NOTIFICATION_EMAIL=ashuchinthapalli3900@gmail.com

# ------------------------------------------------------------------------------
# 4. PUBLIC APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Live Production URL (or http://localhost:3000 for local testing)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AGENCY_URL=https://www.codxa-agency.online
NEXT_PUBLIC_BATCH_NAME=BATCH 2026
